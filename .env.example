# ---------------------------------------------------------------------------
# Multimodal Spatiotemporal Air-Threat Cascade & LLM Intelligence Engine
# Environment template. Copy to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real keys. Every variable below has a safe
# default in src/config.py, so the app also runs with no `.env` at all
# (offline / synthetic mode).
# ---------------------------------------------------------------------------

# --- LLM intelligence layer -------------------------------------------------
# Google Gemini API key. Leave empty to run fully offline; LLM features are
# disabled gracefully and the dashboard falls back to rule-based summaries.
GEMINI_API_KEY=""
# Model used for narrative threat summaries.
GEMINI_MODEL="gemini-2.5-flash"
# Hard switch to disable LLM calls even when a key is present (true/false).
LLM_ENABLED="true"

# --- Data sources -----------------------------------------------------------
# Historical alarm log (CSV). When the file is missing and SYNTHETIC_FALLBACK
# is true, the synthetic generator is used automatically.
ALARMS_CSV_PATH="data/alarms.csv"
SYNTHETIC_FALLBACK="true"
SYNTHETIC_RECORDS="2000"
SYNTHETIC_SEED="42"
SYNTHETIC_START_DATE="2026-01-01"

# --- Temporal safeguard -----------------------------------------------------
# IANA timezone used to interpret naive cutoff timestamps and to label the UI.
# Storage and computation are always UTC. Example: Europe/Kyiv
DEFAULT_CUTOFF_TIMEZONE="UTC"
# Open-ended alarms older than this (hours) are treated as feed gaps, not active.
ACTIVE_WINDOW_HOURS="8"

# --- Cascade model defaults -------------------------------------------------
CASCADE_MAX_LAG_MIN="90"
CASCADE_DECAY_MIN="60"

# --- App / logging ----------------------------------------------------------
APP_ENV="development"
LOG_LEVEL="INFO"
